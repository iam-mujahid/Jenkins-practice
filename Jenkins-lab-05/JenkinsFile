pipeline {

    agent {
        docker {
            image 'node:20-alpine'
            args '-u 0:0'
        }
    }

    stages {

        stage('Install Dependencies') {
            steps {
                dir('Jenkins-lab-05') {
                    sh 'npm install'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('Jenkins-lab-05') {
                    sh 'npm test'
                }
            }
        }

        stage('Build') {
            steps {
                dir('Jenkins-lab-05') {
                    sh 'echo "Building application..."'
                    sh 'ls -la'
                    sh 'echo "Build completed!"'
                }
            }
        }
    }

    post {
        success {
            echo '✅ CI Pipeline SUCCESS'
        }

        failure {
            echo '❌ CI Pipeline FAILED'
        }
    }
}
