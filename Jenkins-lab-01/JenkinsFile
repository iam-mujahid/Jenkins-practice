pipeline {

    agent {
        docker {
            image 'node:20-alpine'
        }
    }

    stages {

        stage('Docker Agent') {
            steps {

                sh 'echo "=== SYSTEM ==="'
                sh 'whoami'
                sh 'hostname'
                sh 'pwd'

                sh 'echo "=== NODE.JS ==="'
                sh 'node --version'

                sh 'echo "=== NPM ==="'
                sh 'npm --version'

                sh 'echo "=== OS ==="'
                sh 'cat /etc/os-release'

                sh 'echo "=== WORKSPACE ==="'
                sh 'ls -la'
            }
        }
    }
}
