pipeline {

    agent any

    stages {

        stage('Hello') {
            steps {
                echo 'Hello from Jenkins!'
            }
        }

        stage('Workspace') {
            steps {
                sh 'echo "Current user:"'
                sh 'whoami'

                sh 'echo "Current directory:"'
                sh 'pwd'

                sh 'echo "Files:"'
                sh 'ls -la'
            }
        }

        stage('Create File') {
            steps {
                sh 'echo "Created by Jenkins" > jenkins-file.txt'
                sh 'cat jenkins-file.txt'
            }
        }

        stage('Check File') {
            steps {
                sh 'pwd'
                sh 'ls -la'
                sh 'cat jenkins-file.txt'
            }
        }

    }
}
