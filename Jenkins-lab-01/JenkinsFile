pipeline {

    agent any

    stages {

        stage('Normal Jenkins Agent') {
            steps {
                sh 'echo "=== SYSTEM ==="'
                sh 'whoami'
                sh 'hostname'
                sh 'pwd'

                sh 'echo "=== NODE.JS ==="'
                sh 'node --version || echo "Node.js is NOT installed"'

                sh 'echo "=== NPM ==="'
                sh 'npm --version || echo "npm is NOT installed"'
            }
        }
    }
}
