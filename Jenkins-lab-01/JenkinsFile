pipeline {

    agent none

    stages {

        stage('Node Stage') {

            agent {
                docker {
                    image 'node:20-alpine'
                    args '-u 0:0'
                }
            }

            steps {

                sh 'echo "=== NODE CONTAINER ==="'
                sh 'whoami'
                sh 'hostname'
                sh 'node --version'

                sh 'echo "Hello from Node container" > shared-file.txt'

                sh 'echo "File created:"'
                sh 'cat shared-file.txt'
            }
        }

        stage('Python Stage') {

            agent {
                docker {
                    image 'python:3.12-alpine'
                    args '-u 0:0'
                }
            }

            steps {

                sh 'echo "=== PYTHON CONTAINER ==="'
                sh 'whoami'
                sh 'hostname'
                sh 'python --version'

                sh 'echo "Reading file created by previous container:"'
                sh 'cat shared-file.txt'
            }
        }
    }
}
